# Frontend React (build statique servi par nginx)
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/yarn.lock ./
# Le plugin Emergent visual-edits est privé : on l'enlève pour le build hors-Emergent
RUN sed -i '/@emergentbase\/visual-edits/d' package.json
RUN yarn install --frozen-lockfile --ignore-scripts || yarn install --ignore-scripts

COPY frontend ./
RUN sed -i '/@emergentbase\/visual-edits/d' package.json
# REACT_APP_BACKEND_URL est lu au moment du build (CRA)
ARG REACT_APP_BACKEND_URL=http://localhost:8001
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
RUN yarn build

# --- Étape runtime ---
FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY frontend/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
